+
+void CubismModel::ClearDrawableForceHiddenFlags()
+{
+    _drawableForceHiddenFlags.Assign(GetDrawableCount(), 0, false);
+}
+
+void CubismModel::SetDrawableForceHidden(csmInt32 drawableIndex, csmBool hidden)
+{
+    if (drawableIndex < 0 || drawableIndex >= GetDrawableCount())
+    {
+        return;
+    }
+
+    if (_drawableForceHiddenFlags.GetSize() != static_cast<csmUint32>(GetDrawableCount()))
+    {
+        ClearDrawableForceHiddenFlags();
+    }
+
+    _drawableForceHiddenFlags[drawableIndex] = hidden ? 1 : 0;
+}
+
+csmBool CubismModel::GetDrawableForceHidden(csmInt32 drawableIndex) const
+{
+    if (drawableIndex < 0 || drawableIndex >= GetDrawableCount())
+    {
+        return false;
+    }
+
+    if (_drawableForceHiddenFlags.GetSize() != static_cast<csmUint32>(GetDrawableCount()))
+    {
+        return false;
+    }
+
+    return _drawableForceHiddenFlags[drawableIndex] != 0;
 }
 
